<Window x:Class="WpfApp6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp6"
        Title="Руль" Height="710" Width="1000" 
        MinHeight="710" MinWidth="1000" 
        WindowStartupLocation="CenterScreen">
    <!-- Убрали Icon, чтобы не падало -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF76E383">
            <Button x:Name="btnBack" HorizontalAlignment="Right" Cursor="Hand" Click="btnBack_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Назад" VerticalAlignment="Center" Margin="10"/>
                </StackPanel>
            </Button>
        </Grid>

        <Frame x:Name="frContent" Grid.Row="1" NavigationUIVisibility="Hidden" ContentRendered="frContent_ContentRendered"/>
    </Grid>
</Window>